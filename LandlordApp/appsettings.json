{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=Landlander;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Connect Timeout=30"
  },
  "Jwt": {
    "Issuer": "landlander",
    "Audience": "account",
    "Secret": "YourSuperSecretKeyForJWTTokenGenerationMustBeAtLeast32CharactersLong"
  },
  "GrpcServerUrl": "https://localhost:7092",
  "SendGrid": {
    "ApiKey": "",
    "SenderEmail": "noreply@landlander.com",
    "SenderName": "Landlander Platform"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "Seq": {
      // Set to your Seq server URL to enable centralized log shipping.
      // Local dev default: http://localhost:5341
      // Leave empty to skip (console + file sinks still active).
      "ServerUrl": "",
      "ApiKey": ""
    }
  },
  "ApplicationInsights": {
    "InstrumentationKey": ""
  },
  "Monri": {
    "AllowedRedirectHosts": [ "localhost", "127.0.0.1" ],
    "AuthenticityToken": "",
    "MerchantKey": "",
    "Plans": {
      "basic": {
        "Name": "Basic",
        "Description": "Basic plan",
        "Amount": "999",
        "Currency": "EUR",
        "Interval": "month"
      }
    }
  },
  "Redis": {
    "Configuration": ""
  },
  "AllowedHosts": "*",
  "App": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "https://localhost:5173"
    ],
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "Security": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15
  },
  "Appointments": {
    "DefaultSlotDurationMinutes": 30,
    "DefaultWorkdayStartHour": 9,
    "DefaultWorkdayEndHour": 17
  },
  "FileUpload": {
    "MaxImageSizeMb": 5,
    "MaxFileSizeMb": 3
  },
  "Idempotency": {
    "TtlHours": 24
  },
  "EmailLog": {
    // Rows older than RetentionDays are deleted nightly by EmailLogCleanupService.
    // 90 days satisfies most GDPR storage-limitation requirements.
    "RetentionDays": 90,
    // UTC hour at which the cleanup job runs (3 = 03:00 UTC).
    "CleanupHourUtc": 3
  },
  "OpenTelemetry": {
    // Set to your OTLP collector endpoint in production (e.g. http://jaeger:4317,
    // https://<region>.otelcol.azure.com/v1/traces, or a Seq OTLP endpoint).
    // Leave empty to use console exporter in Development / no tracing in Production.
    "OtlpEndpoint": ""
  },
  "ML": {
    // Leave empty to use <ContentRoot>/MLModels (single-instance / local dev).
    // In multi-instance deployments set this to a shared filesystem mount point
    // (Azure Files: /mnt/azurefiles/mlmodels, NFS: /nfs/mlmodels, etc.) so all
    // pods read/write the same model.zip and metrics.json files.
    "ModelBasePath": ""
  },
  "Listings": {
    // How many days a listing stays active after creation before expiring.
    "ExpirationDays": 30,
    // Days after expiry during which a landlord can still renew before the listing is soft-deleted.
    "GraceDays": 7,
    // Days before expiry to send the in-app reminder notification to the landlord.
    "ReminderDaysBeforeExpiry": 2,
    // UTC hour at which the expiration background service runs its daily check.
    "CheckHourUtc": 2
  }
}